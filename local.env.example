# Copy this file to local.env or .env and fill in the values you need.
# The CLI searches the current directory and then up to three parent directories.
# It checks local.env before .env and loads the first matching file.

# Jira
JIRA_URL=https://company.atlassian.net
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT=PROJ

# GitHub repository or Project V2
# GH_TOKEN=github_pat_your_token_here
# GH_REPO=owner/repository
# GH_PROJECT=owner/project-number

# Demo mode needs no credentials:
# jira tui --demo

# Optional: write full TUI exception traces to a copyable file.
# JIRA_TUI_LOG=.jira-cli-tui.log
# JIRA_TUI_LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR, or CRITICAL
